# Environment Variables — LogForge
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── Application ───────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# ─── FastAPI ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ─── Elasticsearch ──────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=logs
# Leave blank for local dev, fill for AWS OpenSearch
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs
KAFKA_TOPIC_PROCESSED_LOGS=processed-logs
KAFKA_TOPIC_ALERTS=alerts
KAFKA_CONSUMER_GROUP=logforge-consumers

# ─── PostgreSQL (for alerts/rules) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logforge
POSTGRES_USER=logforge
POSTGRES_PASSWORD=logforge_secret

# ─── ML Model ───────────────────────────────────────────────────
ML_MODEL_PATH=./ml/models/isolation_forest.pkl
ANOMALY_THRESHOLD=0.7
ML_RETRAIN_INTERVAL_HOURS=24

# ─── Alerting ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_FROM_EMAIL=alerts@logforge.io

# ─── AWS (Phase 11 only) ────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY=logforge
ECS_CLUSTER=logforge-cluster
